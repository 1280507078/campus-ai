# ============================================================
#  Campus AI Assistant - 后端环境配置
# ============================================================
#  用法：把本文件复制成 .env，然后按需填写下面的 Key。
#        .env 不会被提交到 git（见 .gitignore），请勿外传。
#
#     复制命令（Windows）：
#         copy backend\.env.example backend\.env
#
#  注意：所有 Key 都**可以留空**。留空时对应功能自动降级为占位
#        文案，项目仍能完整跑通，不会报错。
# ============================================================


# ---------- 智谱 GLM（学业规划 + 情绪陪伴对话）----------
# 申请：https://open.bigmodel.cn  → 注册实名 → API 密钥 → 新建
# 格式：形如 xxxxxxxx.yyyyyyyy（id.secret，中间有个点）
# glm-4-flash 官方承诺「永久免费、不限量」
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 课表截图导入用的**视觉模型**（第四代多模态）。留空则默认 glm-4v-flash。
# 可选：glm-4v-flash（免费）/ glm-4v / glm-4v-plus
# 注意各模型输出上限不同：glm-4v-flash 最多 1024 tokens，其余最多 2048。
# 本项目已按「网格 + 补详情」两轮拆分任务，1024 也够用，无需改这里。
GLM_VISION_MODEL=glm-4v-flash


# ---------- 高德 Web 服务 Key（后端：天气 / 地理编码 / 路径规划）----------
# 申请：https://console.amap.com/dev/key/app → 新建 Key → 选「Web服务」
# ⚠️ 这个和后面前端的 JS API Key 是**两个不同的 Key**，别填混
AMAP_WEB_KEY=


# ---------- 高德 JS API Key（前端：地图显示）----------
# 说明：这两个值前端要用，请填到 frontend/js/config.js 里，
#       不是填在这里。这里列出仅为方便对照：
#         AMAP_JS_KEY        = 在控制台选「Web端(JS API)」创建的 Key
#         AMAP_SECURITY_CODE = 同一个 Key 的「安全密钥 jscode」
#       新版高德要求二者配套，缺一地图会加载失败。


# ---------- Qdrant Cloud（情绪陪伴长期记忆 / RAG）----------
# 留空则记忆功能静默降级（对话仍正常，只是 AI 不记得此前说过的话）。
# 依赖已列在 requirements.txt，启动脚本会自动装 qdrant-client。
# URL 在 Qdrant Cloud 控制台集群详情页，注意**不要带 :6333 端口**，
# 控制台给的那串 https 地址直接用即可：
#     https://xxxxxxxx-xxxx.<region>.cloud.qdrant.io
# API Key 是控制台生成的 JWT（形如 eyJhbGciOi...）。
QDRANT_URL=
QDRANT_API_KEY=


# ---------- 数据库 ----------
# 留空 = 用 SQLite，数据库文件固定在 backend/campus_ai.db（推荐，零配置）
# 想用 MySQL 时填下面这种格式，并确保已安装 pymysql：
#     DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/campus_ai?charset=utf8mb4
DATABASE_URL=


# ---------- 服务端口 ----------
# 一般不用改；启动脚本检测到端口被占用时会自动换端口。
# API_PORT=8000
# WEB_PORT=5500


# ---------- 鉴权密钥 ----------
# 建议改成自己的随机串，例如执行：
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=campus-ai-assistant-dev-secret-key-change-me-in-production-2026
